GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
COURTMATE_DATASTORE=firestore
COURTMATE_AUTH_REQUIRED=true
COURTMATE_DEFAULT_AREA=Whitefield
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
